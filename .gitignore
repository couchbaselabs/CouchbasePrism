# Secrets — never commit
config.yaml
!config.example.yaml
*.pem
*.key

# Dictionary is environment/customer state, not source
dictionary.yaml

# A local checkout some machines still have from before this project moved to
# its own ftsPrism corpus - not referenced by any code, but present on disk
# and must never be accidentally staged/committed (it's a large third-party
# dataset with no redistribution license).
financebench/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Run output
out/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Streamlit auto-generates these as symlinks into .venv (with a hardcoded
# python3.x path), so they dangle on any other machine.
.agents/
.claude/skills/

# docling-serve exports used for one-off diagnosis (12MB+)
file.json
file.md

# Internal Couchbase documents pulled for reference. Never commit these.
# The directory name is deliberately generic so no title leaks into git history.
internal/
