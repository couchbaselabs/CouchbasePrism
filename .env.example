# Copy to .env and fill in. .env is gitignored; this file is not.
# NOTE: use `=` for every key. Colon syntax (KEY: value) does not load as an env var.

# Couchbase Capella — the scope and its collections (catalog, docs, tables,
# figures) are created on backend startup. One scope only; domain
# (finance/banking_reg/life_sciences/...) is a plain field on the catalog
# document, not a scope.
COUCHBASE_CONN_STRING=couchbases://cb.xxxxx.cloud.couchbase.com
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=prism
COUCHBASE_SCOPE=prism
COUCHBASE_COLLECTIONS=catalog,docs,tables,figures

PRISM_DEFAULT_DOMAIN=general

# Docling Serve — cd docling_probe && docker compose up -d
DOCLING_BASE_URL=http://localhost:5001

# Not used at Stage 1. Stage 2/3 (classifier, enricher) will need these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

SERVER_PORT=8080
