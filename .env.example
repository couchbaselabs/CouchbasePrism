# Copy to .env and fill in. .env is gitignored; this file is not.
#
# NOTE: use `=` for every key. Colon syntax (KEY: value) is NOT valid for
# `source`, and the variable will silently be unset rather than erroring.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# --- Couchbase Capella -----------------------------------------------------
# The scope holds `catalog` (one doc per source file) and `docs` (chunks,
# written by the AI Data Plane workflow). PRISM creates the catalog collection's
# primary index on demand; the scope itself should already exist.
COUCHBASE_CONN_STRING=couchbases://cb.xxxxx.cloud.couchbase.com
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET=prism
COUCHBASE_SCOPE=prism

# --- Couchbase AI Data Plane ----------------------------------------------
# Used for query embeddings, and must be the SAME model that the Unstructured
# Data Workflow used to embed the chunks - otherwise the vectors are not
# comparable and retrieval silently degrades.
#
# API_KEY is the API Key TOKEN (starts with `cbsk-`), not the API Key Id (a
# UUID). Using the Id gives a 401 that reads like a bad endpoint.
MODEL_END_POINT=https://xxxxx.ai.cloud.couchbase.com
MODEL_ID=
API_KEY=

# --- Source objects --------------------------------------------------------
# The AI Data Plane workflow derives each chunk's `xmeta-data.filename` from the
# S3 location as {AWS_BUCKET}_{AWS_FOLDER}_{name}.pdf, so PRISM needs both to
# map a catalog doc_name back to its chunks.
AWS_BUCKET=
AWS_FOLDER=

# --- OpenAI ----------------------------------------------------------------
# Planning, fact binding, candidate proposal, answer synthesis and the eval
# judge. Never used for arithmetic that an approved dictionary entry governs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional --------------------------------------------------------------
# Where the approved dictionary lives. Defaults to ./dictionary.yaml, which is
# gitignored: it is environment/customer state, not source.
# PRISM_DICTIONARY=/path/to/dictionary.yaml
